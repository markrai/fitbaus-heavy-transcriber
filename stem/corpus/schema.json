{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitbaus.org/schemas/stem-concept-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "discipline",
    "subject",
    "tags",
    "alternate_names",
    "representations"
  ],
  "properties": {
    "schema": {
      "const": "fitbaus.stem.concept/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "discipline": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "alternate_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representation"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "digest",
        "method",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "latex",
        "conditions",
        "symbols",
        "spoken_aliases",
        "references",
        "mathematical_review",
        "recognition_review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "latex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "symbols": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "spoken_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 64
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "mathematical_review": {
          "$ref": "#/$defs/review"
        },
        "recognition_review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  }
}
